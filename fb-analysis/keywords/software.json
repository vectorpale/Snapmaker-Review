{
  "S1": {
    "name": "Snapmaker Orca (Slicer)",
    "name_zh": "Snapmaker Orca (切片软件)",
    "subcategories": {
      "S1.1": {
        "name": "Software crash",
        "name_zh": "软件崩溃/闪退",
        "keywords_en": [
          "orca crash", "slicer crash", "software crash", "app crash",
          "orca freeze", "orca hang", "orca not responding", "orca close",
          "orca won't open", "snapmaker orca crash", "crash when opening",
          "crash on import", "crash 3mf", "slicer freeze"
        ],
        "keywords_zh": [
          "閃退", "崩潰", "卡死", "軟件崩潰", "切片器崩潰"
        ],
        "patterns": [
          "(?:orca|slicer|software).*(?:crash|freeze|hang|not respond|close unexpect)",
          "crash.*(?:orca|slicer|open|import|3mf)"
        ]
      },
      "S1.2": {
        "name": "Outdated version / missing features",
        "name_zh": "版本过旧，缺少新功能",
        "keywords_en": [
          "outdated", "old version", "behind orca", "orca version",
          "update orca", "latest orca", "missing feature", "not up to date",
          "orca slicer newer", "feature missing", "orca fork", "based on old",
          "upstream orca"
        ],
        "keywords_zh": [
          "版本過舊", "缺少功能", "更新版本", "舊版本"
        ],
        "patterns": [
          "(?:snapmaker\\s*)?orca.*(?:outdat|old|behind|version|update|missing)",
          "(?:outdat|old|behind).*(?:orca|slicer)"
        ]
      },
      "S1.3": {
        "name": "Profile/preset issues",
        "name_zh": "配置文件/预设问题",
        "keywords_en": [
          "profile issue", "preset issue", "wrong profile", "profile missing",
          "default profile", "print profile", "material profile", "custom profile",
          "profile settings", "slicer settings", "preset not working",
          "profile error", "slicer profile"
        ],
        "keywords_zh": [
          "配置文件", "預設問題", "參數設置", "配置檔"
        ],
        "patterns": [
          "(?:print|material|slicer|custom|default)\\s*profile",
          "profile.*(?:issue|problem|wrong|missing|error|not work)",
          "preset.*(?:issue|problem|wrong|missing|error|not work)"
        ]
      },
      "S1.4": {
        "name": "Incompatible with Bambu Studio 3mf",
        "name_zh": "不兼容 Bambu Studio 3mf 文件",
        "keywords_en": [
          "bambu 3mf", "bambu studio 3mf", "3mf incompatible", "import 3mf",
          "3mf file", "can't open 3mf", "3mf error", "bambu file",
          "3mf format", "3mf import"
        ],
        "keywords_zh": [
          "3mf文件", "不兼容", "無法導入"
        ],
        "patterns": [
          "(?:bambu|3mf).*(?:incompatib|not compat|can't open|error|import|fail)",
          "(?:import|open).*3mf.*(?:fail|error|issue)"
        ]
      }
    }
  },
  "S2": {
    "name": "Firmware",
    "name_zh": "固件",
