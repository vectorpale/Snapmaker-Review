        "keywords_zh": [
          "固件版本", "韌體版本", "固件bug"
        ],
        "patterns": [
          "(?:fw|firmware)\\s*(?:v?\\d+\\.\\d+)",
          "(?:fw|firmware)\\s*(?:version|bug)"
